# ===== mediahub 配置（复制成 .env 再填写；.env 不要提交到 Git）=====

# 网页登录密码（必填）
APP_PASSWORD=
# 会话签名密钥，可留空（留空会自动生成并保存在 data/.session_secret）
SESSION_SECRET=
# 网页端口（只监听 127.0.0.1，由 Caddy 反代）
APP_PORT=8095
# 通过 HTTPS（Caddy）访问时保持 true；只在本机 http 调试时改成 false
COOKIE_SECURE=true

# OpenList（v4）——建议用能看到隐藏文件的账号
OPENLIST_URL=http://127.0.0.1:5244
OPENLIST_USER=
OPENLIST_PASSWORD=

# TMDB：v3 API Key 或 v4 读取令牌（eyJ 开头）都可以
TMDB_API_KEY=

# 目录
STAGING_MOVIES=/guangdong/娱乐/影视/待整理/电影
STAGING_TV=/guangdong/娱乐/影视/待整理/电视剧
# 链接名字看不出电影/电视剧时，先云下载到这里的“任务号”子文件夹，下完按文件自动分类再移走（从不删除）
STAGING_UNSORTED=/guangdong/娱乐/影视/待整理/未分类
LIBRARY_MOVIES=/guangdong/娱乐/影视/电影
LIBRARY_TV=/guangdong/娱乐/影视/电视剧

# 115 节奏：每个写操作之间隔几秒；每次移动后等几秒（115 移动是异步的）
RENAME_INTERVAL=2
MOVE_WAIT=20
# 单次请求超时（秒）。改名超时不会重试，最后统一核对
REQUEST_TIMEOUT=30
# 移动被 115 以 990009“操作尚未执行完成”拒绝时，等 2×MOVE_WAIT 再试一次（只针对明确拒绝，不针对超时）
MOVE_RETRY_ON_BUSY=true
# 小于这个大小（MB）的视频文件当作广告，不改名、不删除、不算集数
AD_MAX_SIZE_MB=5
# 中文名来源：tmdb（TMDB 简体中文名）或 folder（文件夹里的中文名优先）
TITLE_SOURCE=tmdb

# 可选：任务结束发 Telegram 通知（两个都填才会发）
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# 第一阶段：磁力投递 / 内部 API（机器人调用）。令牌请用随机长字符串，不要提交到 Git。
MEDIAHUB_INTERNAL_TOKEN=
# 通知和预览链接用的公网地址（按实际部署填写）
# 大阪示例：https://media.sumax.duckdns.org:8443
# 杭州示例：https://YOUR_HANGZHOU_IP:8443
MEDIAHUB_PUBLIC_URL=https://media.example.com:8443
# 盯梢 115 离线任务的间隔（秒），建议 60–120；设成 0 关闭后台轮询（测试用）
DOWNLOAD_POLL_INTERVAL=90
# 下载完成后如果目录列表可能滞后，再等几秒刷新一次（测试可设 0）
DOWNLOAD_REFRESH_WAIT=30
# 全自动入库（默认开）：下完 + 分类 + 扫描后，安全条件都满足就自动改名并移进正式片库。
# 不写就是开；写 false 关闭。网页首页或机器人 /auto on|off 可以临时覆盖（存在 data/auto_organize.json）。
# AUTO_ORGANIZE=true
